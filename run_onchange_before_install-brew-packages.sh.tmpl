#!/bin/bash
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "Installing packages from Brewfile..."
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

# --adopt lets a cask take over an app already sitting in /Applications, but only
# when the existing copy is identical to the cask version. A hand-installed app at
# a different version still fails, and brew bundle exits non-zero if any single
# entry fails -- which under `set -e` would abort the whole chezmoi apply even
# though every other package installed fine. So warn instead of aborting.
if ! HOMEBREW_CASK_OPTS="--adopt" brew bundle --file="$BREWFILE"; then
  echo "" >&2
  echo "warning: some Brewfile entries failed to install." >&2
  echo "A common cause is a cask whose app was installed manually outside brew." >&2
  echo "List them with: brew bundle check --verbose --file=\"$BREWFILE\"" >&2
  echo "Adopt one with: brew install --cask --adopt <name>" >&2
fi
echo "Brew packages step complete."
