  {
    "name": "Herdr Keys: Panes",
    "text": "prefix + h/j/k/l → move between panes\nprefix + v       → split side by side\nprefix + -       → split stacked\nprefix + z       → zoom pane (toggle)\nprefix + x       → close pane\nAlt+Arrow        → resize pane\nprefix + e       → scrollback in nvim",
    "keyword": ";;hkp"
  },
  {
    "name": "Herdr Keys: Tabs & Workspaces",
    "text": "prefix + c       → new tab\nprefix + n / p   → next / previous tab\nprefix + 1..9    → jump to tab\nprefix + w       → workspace picker\nprefix + Shift+N → new workspace\nAlt+Shift+H/L    → prev / next workspace\nprefix + d       → detach (keeps running)",
    "keyword": ";;hkw"
  },
  {
    "name": "Herdr Keys: Popups",
    "text": "prefix + g → lazygit popup\nprefix + f → floating terminal\nprefix + ? → help\nprefix + s → settings",
    "keyword": ";;hkg"
  },
  {
    "name": "Neovim Keys: Find & Search",
    "text": "<Space>ff → find files\n<Space>fg → live grep (search in files)\n<Space>fr → recent files\n<Space>fb → browse buffers\n<Space>sg → grep across project\n<Space>sw → search word under cursor\n<Space>/  → fuzzy search in buffer",
    "keyword": ";;nkf"
  },
  {
    "name": "Neovim Keys: Navigation",
    "text": "<Space>e   → file explorer (neo-tree)\n<Space>bb  → switch buffer\n<Space>gc  → git commits\n<Space>gs  → git status (changed files)\n<Space>sH  → help tags\n<Space>sk  → keymaps\n<Space>sR  → resume last telescope picker",
    "keyword": ";;nkn"
  },
  {
    "name": "Yazi Keys: Search & Navigate",
    "text": "s     → search files by name (fd)\nS     → search files by content (rg)\nCtrl+S→ cancel search\nz     → jump via fzf\nZ     → jump via zoxide\nf     → filter current dir\n/     → find next   ? → find prev\nn / N → next / prev match",
    "keyword": ";;yk"
  },
  {
    "name": "fzf Keys: Built-in",
    "text": "Ctrl+T → fuzzy find file/dir, paste path\nAlt+C  → fuzzy find dir, cd into it\nCtrl+R → fuzzy search history (atuin overrides this)",
    "keyword": ";;fzk"
  },
