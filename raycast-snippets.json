  {
    "name": "Tmux Keys: Pane Navigation",
    "text": "Ctrl+h/j/k/l → move between panes (works from nvim too)\nAlt+Arrow    → move between panes (no prefix)\nprefix + z   → zoom pane to fullscreen (toggle)",
    "keyword": ";;tkp"
  },
  {
    "name": "Tmux Keys: Windows & Sessions",
    "text": "Shift+Left/Right → switch windows\nAlt+H / Alt+L    → switch windows (vim style)\nprefix + c       → new window\nprefix + o       → session picker (sessionx + zoxide)\nprefix + p       → floating terminal (floax)\nprefix + d       → detach session",
    "keyword": ";;tkw"
  },
  {
    "name": "Tmux Keys: Splits",
    "text": "prefix + \"  → split horizontal (current path)\nprefix + %  → split vertical (current path)",
    "keyword": ";;tks"
  },
  {
    "name": "Tmux Keys: Copy Mode (vi)",
    "text": "prefix + [  → enter copy mode\nv           → start selection\nCtrl+v      → rectangle selection\ny           → copy and exit\n/           → search forward\n?           → search backward",
    "keyword": ";;tkc"
  },

  {
    "name": "Neovim Keys: Find & Search",
    "text": "<Space>ff → find files\n<Space>fg → live grep (search in files)\n<Space>fr → recent files\n<Space>fb → browse buffers\n<Space>sg → grep across project\n<Space>sw → search word under cursor\n<Space>/  → fuzzy search in buffer",
    "keyword": ";;nkf"
  },
  {
    "name": "Neovim Keys: Navigation",
    "text": "<Space>e   → file explorer (neo-tree)\n<Space>bb  → switch buffer\n<Space>gc  → git commits\n<Space>gs  → git status (changed files)\n<Space>sH  → help tags\n<Space>sk  → keymaps\n<Space>sR  → resume last telescope picker",
    "keyword": ";;nkn"
  },
  {
    "name": "Neovim Keys: 99.nvim AI",
    "text": "<leader>mm → select AI model\n<leader>9v → AI on visual selection\n<leader>9s → stop all AI requests",
    "keyword": ";;nka"
  },

  {
    "name": "Yazi Keys: Search & Navigate",
    "text": "s     → search files by name (fd)\nS     → search files by content (rg)\nCtrl+S→ cancel search\nz     → jump via fzf\nZ     → jump via zoxide\nf     → filter current dir\n/     → find next   ? → find prev\nn / N → next / prev match",
    "keyword": ";;yk"
  },

  {
    "name": "fzf Keys: Built-in",
    "text": "Ctrl+T → fuzzy find file/dir, paste path\nAlt+C  → fuzzy find dir, cd into it\nCtrl+R → fuzzy search history (atuin overrides this)",
    "keyword": ";;fzk"
  },

  {
    "name": "Combo: Jump to project + code",
    "text": "cd {cursor} && nvim .",
    "keyword": ";;go"
  },
  {
    "name": "AST: Structural code search",
    "text": "ast-grep \"{cursor}\"",
    "keyword": ";;ast"
  },
  {
    "name": "Quick help for a command",
    "text": "tldr {cursor}",
    "keyword": ";;tldr"
  }
