  {
    "name": "fzf: rg → pick → open in nvim at line",
    "text": "rg --line-number . | fzf --delimiter : --preview 'bat --color=always {1} --highlight-line {2}' | awk -F: '{print \"+\"$2, $1}' | xargs nvim",
    "keyword": ";;fzrg"
