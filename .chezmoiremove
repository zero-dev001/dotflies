# Targets to delete on apply. Removing a file from the chezmoi source only makes
# it unmanaged -- it stays on disk -- so retired files are listed here to ensure
# they are actually removed, including on other machines that auto-sync.

# Retired nvim config: dead LazyVim starter boilerplate, config for neoconf/neodev
# (never installed; LazyVim uses lazydev.nvim), and stay-centered.nvim (replaced by
# the built-in scrolloff option).
.config/nvim/lua/plugins/example.lua
.config/nvim/lua/plugins/stay-centered.lua
.config/nvim/.neoconf.json

# Retired Powerlevel10k config: the prompt is Starship (ZSH_THEME is empty and
# .zshrc never sourced ~/.p10k.zsh), so this file was dead weight.
.p10k.zsh

# Retired rsync backup: a global core.hooksPath post-commit hook that mirrored one
# hardcoded project tree on every commit in every repo. No longer used.
.githooks

# Retired Syncthing global ignore file: Syncthing is no longer installed.
.stignore-global

# Retired LazyVim starter boilerplate: the nvim config was cloned from
# LazyVim/starter, whose nested .git has been removed. Its .gitignore (plugin-dev
# patterns), README and LICENSE described the template, not this config.
.config/nvim/.gitignore
.config/nvim/README.md
.config/nvim/LICENSE

# Retired Ghostty config: the terminal emulator is iTerm2 and the Ghostty cask
# was dropped from the Brewfile. The config still pointed at tmux (replaced by
# Herdr) and a JetBrainsMono Nerd Font that was never installed.
.config/ghostty
